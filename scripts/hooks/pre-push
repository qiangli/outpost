#!/bin/sh
# pre-push — two gates: gofmt, then the standalone module graph.
#
# Siblings are go.mod pins (requires at pseudo-versions, versioned fork
# replaces). Inside the dhnt umbrella the go.work builds the live sibling
# trees, so a local build cannot catch code that needs a newer sibling than
# go.mod pins; resolving the graph with GOWORK=off checks what CI builds.
# `bashy mod drift` shows pins that trail their sibling HEADs.
#
# Install once per clone (`make hooks`): git config core.hooksPath scripts/hooks
# Bypass in an emergency with: git push --no-verify
set -eu
cd "$(git rev-parse --show-toplevel)"
./scripts/fmtcheck.sh
GOWORK=off go list -deps ./cmd/outpost >/dev/null
