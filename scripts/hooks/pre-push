#!/bin/sh
# pre-push — two gates: gofmt, then .sibling-pins drift.
#
# Install once per clone:
#   git config core.hooksPath scripts/hooks
# Bypass in an emergency with: git push --no-verify
#
# Neither gate is inlined here — both live in scripts/ so the hook and the
# manual invocations (`make fmtcheck`, `scripts/update-sibling-pins.sh`) can
# never check different things.
#
# fmtcheck runs first because it costs milliseconds. It REPORTS and never
# rewrites: gofmt changes doc-comment text as well as whitespace, so which
# files take its output is a decision rather than an automation. Read that
# script's header before making it auto-fix.
#
# THE PIN GATE IS WHY THIS HOOK EXISTS AT ALL.
#
# .sibling-pins is the only sibling source CI ever sees: a standalone clone has
# no siblings, so scripts/bootstrap-siblings.sh clones each one at the pinned
# SHA. Inside the dhnt umbrella the siblings are submodules and the pins are
# never consulted — which means A LOCAL BUILD CANNOT CATCH A STALE PIN. It
# builds the live sibling and passes; CI builds the pinned one and fails
# minutes later with a mystifying "no required module provides package" for
# code that plainly exists.
#
# That is not a hypothetical. A sibling repo in this family sat with a pin 26
# commits behind the commit that introduced a package it imports, so every CI
# run failed to compile while every local build was green. Push time is the
# only honest moment to notice.
set -eu

cd "$(git rev-parse --show-toplevel)"

./scripts/fmtcheck.sh

pins=.sibling-pins
[ -f "$pins" ] || exit 0

drift=''
while IFS= read -r line; do
	case "$line" in
	'' | '#'*) continue ;;
	esac
	name=${line%%=*}
	pinned=${line#*=}
	pinned=$(printf %s "$pinned" | tr -d '[:space:]') # strip CR (CRLF) / stray whitespace
	[ -n "$name" ] && [ -n "$pinned" ] && [ "$name" != "$pinned" ] || continue

	dir=../$name
	# A standalone clone has no siblings to compare against — nothing to police.
	[ -e "$dir/.git" ] || continue
	actual=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || continue
	[ "$pinned" = "$actual" ] && continue

	if [ -z "$drift" ]; then
		echo "pre-push: .sibling-pins is stale — CI would build the wrong sibling." >&2
		echo >&2
		drift=yes
	fi
	printf '  %-12s pinned %s\n' "$name" "$(printf %s "$pinned" | cut -c1-12)" >&2
	printf '  %-12s actual %s  (%s HEAD)\n' '' "$(printf %s "$actual" | cut -c1-12)" "$dir" >&2
	echo >&2
done <"$pins"

[ -n "$drift" ] || exit 0

cat >&2 <<'EOF'
Fix (resync the pins to the sibling HEADs, then commit them with your change):

  ./scripts/update-sibling-pins.sh
  git commit -am 'chore: bump .sibling-pins'

The sibling commit must also be pushed to its own origin — CI clones the pin
from GitHub, so a SHA that exists only on this machine fails there too.

Bump the pins LAST, after every sibling commit is final: the check is strict
equality with the sibling's HEAD, so one more sibling commit re-stales it.

Bypass (you are certain CI has the sibling it needs): git push --no-verify
EOF
exit 1
